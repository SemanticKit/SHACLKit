@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:ScopeShape
    a sh:NodeShape ;
    sh:targetNode ex:scope ;
    sh:property ex:LimitProperty .

ex:LimitProperty
    sh:expression ex:LimitExpr ;
    sh:hasValue ex:alice .

ex:LimitExpr
    shnex:nodesMatching ex:PersonShape ;
    shnex:limit 1 .

ex:PersonShape
    a sh:NodeShape ;
    sh:class ex:Person .
