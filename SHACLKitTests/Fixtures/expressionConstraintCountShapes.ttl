@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:alice ;
    sh:property ex:TagCountShape .

ex:TagCountShape
    sh:expression ex:TagCountExpr ;
    sh:hasValue 2 .

ex:TagCountExpr
    shnex:count [
        shnex:pathValues ex:tag
    ] .
