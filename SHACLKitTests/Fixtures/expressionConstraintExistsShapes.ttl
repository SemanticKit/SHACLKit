@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:alice ;
    sh:expression ex:HasNameExpr .

ex:HasNameExpr
    shnex:exists ex:NameValuesExpr .

ex:NameValuesExpr
    shnex:pathValues ex:name .
