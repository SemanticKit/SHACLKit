@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:sparql ex:NameConstraint .

ex:NameConstraint
  sh:prefixes ex:PrefixConfig ;
  sh:select "SELECT ?this WHERE { ?this :name ?name . FILTER(strlen(str(?name)) = 0) }" .

ex:PrefixConfig
  sh:declare [
    sh:prefix "" ;
    sh:namespace "http://example.com/"
  ] .
