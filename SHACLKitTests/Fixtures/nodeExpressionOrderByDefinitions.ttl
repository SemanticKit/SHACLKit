@prefix ex: <http://example.com/> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:OrderByAscLimitExpr
    shnex:nodes [
        shnex:nodes ( 8 2 3 ) ;
        shnex:orderBy [
            shnex:var "focusNode" ;
        ] ;
    ] ;
    shnex:limit 1 .

ex:OrderByDescLimitExpr
    shnex:nodes [
        shnex:nodes ( 8 2 3 ) ;
        shnex:orderBy [
            shnex:var "focusNode" ;
        ] ;
        shnex:desc true ;
    ] ;
    shnex:limit 1 .

ex:OrderByNumericLimitExpr
    shnex:nodes [
        shnex:nodes ( 10 2 ) ;
        shnex:orderBy [
            shnex:var "focusNode" ;
        ] ;
    ] ;
    shnex:limit 1 .
