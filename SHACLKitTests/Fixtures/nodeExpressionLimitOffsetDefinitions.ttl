@prefix ex: <http://example.com/> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:LimitExpr
    shnex:nodes ( 1 2 3 4 ) ;
    shnex:limit 2 .

ex:OffsetExpr
    shnex:nodes ( 1 2 3 4 ) ;
    shnex:offset 2 .

ex:OffsetAfterLimitExpr
    shnex:nodes [
        shnex:nodes ( 5 6 7 8 ) ;
        shnex:limit 2 ;
    ] ;
    shnex:offset 1 .

ex:OffsetThenLimitFromConcatExpr
    shnex:nodes [
        shnex:nodes [
            shnex:concat (
                ( 5 4 )
                ( 3 2 1 )
            ) ;
        ] ;
        shnex:offset 2 ;
    ] ;
    shnex:limit 1 .
