@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:alice ;
    sh:property ex:DerivedNameShape .

ex:DerivedNameShape
    sh:expression ex:FriendNameExpression ;
    sh:hasValue "Bob" .

ex:FriendNameExpression
    shnex:pathValues ex:name ;
    shnex:focusNode [
        shnex:pathValues ex:friend
    ] .
