@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:sparql ex:NameConstraint .

ex:NameConstraint
  sh:select """
    SELECT ?focus WHERE {
      # ?this appears only in a comment and should not satisfy pre-bound this reference checks.
      ?focus ex:name ?name .
      FILTER(strlen(str(?name)) = 0)
    }
  """ .
