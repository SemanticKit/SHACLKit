@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:GuardedPreboundPathShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:sparql ex:UnsafePreboundPathConstraint .

ex:UnsafePreboundPathConstraint
  sh:select "SELECT ?this WHERE { BIND(ex:name AS ?path) ?this ex:name ?name }" .
