@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:ScopeShape
    a sh:NodeShape ;
    sh:targetNode ex:scope ;
    sh:property ex:InstancesOfProperty .

ex:InstancesOfProperty
    sh:expression ex:InstancesOfExpr ;
    sh:hasValue ex:alice .

ex:InstancesOfExpr
    shnex:instancesOf ex:Person .
