@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property ex:AddressShape .

ex:AddressShape a sh:PropertyShape ;
  sh:path ex:address ;
  sh:property ex:ZipShape .

ex:ZipShape a sh:PropertyShape ;
  sh:path ex:zip ;
  sh:sparql ex:ZipConstraint .

ex:ZipConstraint
  sh:select "SELECT $this ?value WHERE { $this $PATH ?value . FILTER(strlen(str(?value)) = 0) }" .
