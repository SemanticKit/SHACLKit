@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:ScopeShape
    a sh:NodeShape ;
    sh:targetNode ex:scope ;
    sh:property ex:FilterShapeProperty .

ex:FilterShapeProperty
    sh:expression ex:FilterShapeExpr ;
    sh:hasValue ex:alice .

ex:FilterShapeExpr
    shnex:filterShape ex:PersonShape ;
    shnex:nodes ( ex:alice ex:bob ex:charlie ) .

ex:PersonShape
    a sh:NodeShape ;
    sh:class ex:Person .
