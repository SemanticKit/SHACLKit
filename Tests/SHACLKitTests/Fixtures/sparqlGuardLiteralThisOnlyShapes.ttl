@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:sparql ex:NameConstraint .

ex:NameConstraint
  sh:select "SELECT ?focus WHERE { ?focus ex:name ?name . BIND('?this' AS ?marker) FILTER(strlen(str(?name)) = 0) }" .
