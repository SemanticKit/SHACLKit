@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:OrganizationsExpr
    shnex:instancesOf ex:Organization .

ex:CompaniesExpr
    shnex:instancesOf ex:Company .

ex:Company rdfs:subClassOf ex:Organization .

ex:Org1 rdf:type ex:Organization .
ex:Company1 rdf:type ex:Company .
ex:Company2 rdf:type ex:Company .
ex:Country1 rdf:type ex:Country .
