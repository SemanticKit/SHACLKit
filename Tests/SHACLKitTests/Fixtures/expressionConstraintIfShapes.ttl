@prefix ex: <http://example.com/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetNode ex:alice ;
    sh:expression ex:IfHasName .

ex:IfHasName
    shnex:if ex:HasNameExpr ;
    shnex:then true ;
    shnex:else false .

ex:HasNameExpr
    shnex:exists [
        shnex:pathValues ex:name
    ] .
