@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:GuardedPreboundValueShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:sparql ex:UnsafePreboundValueConstraint .

ex:UnsafePreboundValueConstraint
  sh:select "SELECT ?this WHERE { ?this ex:name ?name . BIND(?name AS ?value) }" .
