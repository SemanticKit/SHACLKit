@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:OrderByBirthdayAscLimitExpr
    shnex:nodes [
        shnex:nodes [
            shnex:instancesOf ex:Person ;
        ] ;
        shnex:orderBy [
            shnex:pathValues ex:birthDay ;
        ] ;
    ] ;
    shnex:limit 1 .

ex:OrderByBirthdayDescLimitExpr
    shnex:nodes [
        shnex:nodes [
            shnex:instancesOf ex:Person ;
        ] ;
        shnex:orderBy [
            shnex:pathValues ex:birthDay ;
        ] ;
        shnex:desc true ;
    ] ;
    shnex:limit 1 .

ex:OrderByHeightAscLimitExpr
    shnex:nodes [
        shnex:nodes [
            shnex:instancesOf ex:Person ;
        ] ;
        shnex:orderBy [
            shnex:pathValues ex:height ;
        ] ;
    ] ;
    shnex:limit 1 .

ex:Person1
    rdf:type ex:Person ;
    ex:birthDay "1971-07-07"^^xsd:date ;
    ex:height 180.0 .

ex:Person2
    rdf:type ex:Person ;
    ex:birthDay "2007-07-11"^^xsd:date ;
    ex:height 169 .

ex:Person3
    rdf:type ex:Person ;
    ex:birthDay "2004-08-07"^^xsd:date .
