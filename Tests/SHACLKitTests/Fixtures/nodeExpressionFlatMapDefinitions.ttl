@prefix ex: <http://example.com/> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .

ex:FlatMapIdentity
    shnex:nodes ( ex:alice ex:bob ex:charlie ) ;
    shnex:flatMap [ shnex:var "focusNode" ] .

ex:FlatMapSkills
    shnex:nodes [
        shnex:pathValues ex:employee ;
        shnex:focusNode ex:CompanyA ;
    ] ;
    shnex:flatMap [
        shnex:pathValues ex:skill ;
    ] .

ex:CompanyA
    ex:employee ex:Employee1 ;
    ex:employee ex:Employee2 ;
    ex:employee ex:Employee3 .

ex:Employee1
    ex:skill "Java"@en ;
    ex:skill "Python"@en ;
    ex:skill "SQL"@en .

ex:Employee2
    ex:skill "Python"@en ;
    ex:skill "JavaScript"@en .

ex:Employee3
    ex:skill "Java"@en ;
    ex:skill "DevOps"@en .
