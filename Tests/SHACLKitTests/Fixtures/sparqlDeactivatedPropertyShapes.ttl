@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property ex:NameShape .

ex:NameShape a sh:PropertyShape ;
  sh:path ex:name ;
  sh:deactivated true ;
  sh:sparql ex:NonEmptyNameConstraint .

ex:NonEmptyNameConstraint
  sh:select "SELECT $this ?value WHERE { $this $PATH ?value . FILTER(strlen(str(?value)) = 0) }" .
